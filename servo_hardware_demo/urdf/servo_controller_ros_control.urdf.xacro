<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Macro to load the servo_hardware ros2_control component

    Parameters:
      - name: Name of the ros2_control tag (default: "servo_hardware_interface")
      - device: Serial device path (required, e.g., "/dev/ttyUSB0")
      - prefix: Joint name prefix (optional, default: "")
      - baudrate: Serial port baudrate (optional, default: "115200")
  -->
  <xacro:macro name="servo_hardware_ros2_control" params="name:=servo_hardware_interface device prefix:='' baudrate:=115200">

    <ros2_control name="${name}" type="system">

      <hardware>
        <plugin>servo_hardware/ServoHardware</plugin>
        <param name="device">${device}</param>
        <param name="prefix">${prefix}</param>
        <param name="baudrate">${baudrate}</param>
      </hardware>

      <joint name="joint_0">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>

      <joint name="joint_1">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>
