<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="servo_controller">

  <!-- Include ros2_control configuration -->
  <xacro:include filename="$(find servo_hardware_test)/urdf/servo_controller_ros_control.urdf.xacro" />

  <!-- Material definitions -->
  <material name="servo_body_color">
    <color rgba="0.2 0.2 0.2 1.0" />
  </material>

  <material name="servo_arm_color">
    <color rgba="0.8 0.8 0.8 1.0" />
  </material>

  <material name="base_color">
    <color rgba="0.4 0.4 0.4 1.0" />
  </material>

  <!-- Macro for a single servo assembly -->
  <xacro:macro name="servo_assembly" params="index y_position">

    <!-- Static mounting link -->
    <link name="servo_mount_${index}">
      <visual>
        <origin xyz="0.025 0 0" rpy="0 ${pi/2} 0" />
        <geometry>
          <cylinder radius="0.025" length="0.05" />
        </geometry>
        <material name="servo_body_color" />
      </visual>
    </link>

    <!-- Static joint connecting mount to base -->
    <joint name="servo_mount_joint_${index}" type="fixed">
      <parent link="base_link" />
      <child link="servo_mount_${index}" />
      <origin xyz="0 ${y_position} 0" rpy="0 0 0" />
    </joint>

    <!-- Servo arm link -->
    <link name="servo_arm_${index}">
      <visual>
        <!-- Servo horn base (disk) -->
        <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
        <geometry>
          <cylinder radius="0.015" length="0.005" />
        </geometry>
        <material name="servo_arm_color" />
      </visual>
      <visual>
        <!-- Servo arm (rectangular extension) -->
        <origin xyz="0 0 0.025" rpy="0 0 0" />
        <geometry>
          <box size="0.005 0.01 0.05" />
        </geometry>
        <material name="servo_arm_color" />
      </visual>
    </link>

    <!-- Rotational joint (around x-axis) -->
    <joint name="joint_${index}" type="revolute">
      <parent link="servo_mount_${index}" />
      <child link="servo_arm_${index}" />
      <origin xyz="0.05 0 0" rpy="0 0 0" />
      <axis xyz="1 0 0" />
      <limit lower="${60*pi/180}" upper="${110*pi/180}" effort="10.0" velocity="1.0" />
    </joint>

  </xacro:macro>

  <!-- Base link -->
  <link name="base_link"/>

  <!-- Instantiate four servo assemblies at specified positions -->
  <xacro:servo_assembly index="0" y_position="-0.15" />
  <xacro:servo_assembly index="1" y_position="-0.05" />
  <xacro:servo_assembly index="2" y_position="0.05" />
  <xacro:servo_assembly index="3" y_position="0.15" />

  <!-- Include ros2_control hardware interface -->
  <xacro:arg name="device" default="/dev/ttyUSB0" />
  <xacro:servo_hardware_ros2_control
    name="servo_hardware_interface"
    device="$(arg device)"
    baudrate="115200" />

</robot>
